# URL HTTPS de una API externa (FastAPI). Es pública: va dentro del código del navegador.
# Vacía: la web usa /api de su propio dominio (la función de Vercel en web/api/), y en desarrollo
# `npm run dev` manda /api a http://127.0.0.1:8000.
VITE_API_BASE_URL=
# Commit que se despliega; Vercel lo entrega en VERCEL_GIT_COMMIT_SHA.
VITE_COMMIT=
# Enlace al registro de experimentos que abre el catálogo.
VITE_MLFLOW_URL=https://dagshub.com/kevin-nieto-callejas/autonomous-rally/experiments
